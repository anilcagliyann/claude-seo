{
  "permissions": {
    "allow": [
      "Bash(scripts/claude-seo run gsc_period_report.py:*)",
      "Bash(./scripts/claude-seo run gsc_period_report.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
